{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "damage_curve_library.capability_declaration.v3",
  "title": "Pathway-aware damage-curve capability declaration v3",
  "type": "object",
  "required": [
    "schema_version",
    "cell_id",
    "canonical_runtime_artifact",
    "pathway_capabilities",
    "consumer_annual_metrics",
    "cap_binding",
    "promotion_gate"
  ],
  "properties": {
    "schema_version": {
      "const": "capability_declaration.v3"
    },
    "cell_id": {
      "type": "string",
      "minLength": 1
    },
    "canonical_runtime_artifact": {
      "type": "boolean"
    },
    "pathway_capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "pathway_id",
          "failure_unit_scalar_dr",
          "scenario_loss_given_value_basis",
          "curve_intrinsic_spread",
          "populated_emit_modes",
          "conditions",
          "limitation_flags",
          "withheld_failure_units"
        ],
        "properties": {
          "pathway_id": {
            "type": "string",
            "minLength": 1
          },
          "failure_unit_scalar_dr": {
            "enum": [
              "supported",
              "conditional",
              "withheld"
            ]
          },
          "scenario_loss_given_value_basis": {
            "enum": [
              "supported_with_explicit_failure_unit_value_and_exposure_basis",
              "conditional",
              "withheld"
            ]
          },
          "curve_intrinsic_spread": {
            "enum": [
              "probabilistic_distribution",
              "nonprobabilistic_epistemic_envelope",
              "not_carried",
              "not_applicable_no_runtime_curve"
            ]
          },
          "populated_emit_modes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "scalar_mean",
                "scalar_mean_plus_bounds",
                "discrete_state_table",
                "parametric_distribution",
                "state_ensemble"
              ]
            }
          },
          "conditions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "limitation_flags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "withheld_failure_units": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "failure_unit_id",
                "reason_codes"
              ],
              "properties": {
                "failure_unit_id": {
                  "type": "string"
                },
                "reason_codes": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "consumer_annual_metrics": {
      "type": "object",
      "required": [
        "computation_owner",
        "status_before_promotion",
        "status_after_promotion",
        "prerequisites",
        "limitation_flags"
      ],
      "properties": {
        "computation_owner": {
          "const": "downstream_consumer"
        },
        "status_before_promotion": {
          "const": "withheld_noncanonical_proposal"
        },
        "status_after_promotion": {
          "enum": [
            "consumer_computable_from_validated_frequency_intensity_coupling_value_and_cap_model",
            "withheld"
          ]
        },
        "prerequisites": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "limitation_flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "cap_binding": {
      "type": "object",
      "required": [
        "policy",
        "enforcement_owner",
        "checks_required",
        "action_if_fail"
      ],
      "properties": {
        "policy": {
          "const": "consumer_enforced_fail_closed"
        },
        "enforcement_owner": {
          "const": "downstream_consumer"
        },
        "checks_required": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "action_if_fail": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "promotion_gate": {
      "type": "object",
      "required": [
        "status",
        "required_before_canonical_use"
      ],
      "properties": {
        "status": {
          "enum": [
            "blocked",
            "ready_for_review",
            "passed"
          ]
        },
        "required_before_canonical_use": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
