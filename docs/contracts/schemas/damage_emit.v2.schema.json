{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "damage_curve_library.damage_emit.v2",
  "title": "Pathway-aware damage emit v2",
  "type": "object",
  "required": [
    "schema_version",
    "cell_id",
    "damage_code_id",
    "model_version",
    "pathway_id",
    "emit_mode",
    "hazard_input_used",
    "failure_unit_results"
  ],
  "properties": {
    "schema_version": {
      "const": "damage_emit.v2"
    },
    "cell_id": {
      "type": "string",
      "minLength": 1
    },
    "damage_code_id": {
      "type": "string",
      "minLength": 1
    },
    "model_version": {
      "type": "string",
      "pattern": "^model v[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"
    },
    "pathway_id": {
      "type": "string",
      "minLength": 1
    },
    "emit_mode": {
      "enum": [
        "scalar_mean",
        "scalar_mean_plus_bounds",
        "discrete_state_table",
        "parametric_distribution",
        "state_ensemble"
      ]
    },
    "hazard_input_used": {
      "type": "object"
    },
    "input_quality": {
      "type": "object"
    },
    "selectors_used": {
      "type": "object"
    },
    "conditioners_used": {
      "type": "object"
    },
    "exposure_used": {
      "type": "object"
    },
    "failure_unit_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "pathway_id",
          "failure_unit_id",
          "curve_id",
          "subsystem",
          "component",
          "status"
        ],
        "properties": {
          "pathway_id": {
            "type": "string",
            "minLength": 1
          },
          "failure_unit_id": {
            "type": "string",
            "minLength": 1
          },
          "curve_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "subsystem": {
            "type": "string"
          },
          "component": {
            "type": "string"
          },
          "status": {
            "enum": [
              "supported",
              "conditional",
              "withheld"
            ]
          },
          "scalar_central_dr": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "scenario_drs": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "state_probabilities_by_scenario": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "withheld_reason_codes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "metadata_flags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "capability_declaration_ref": {
      "type": [
        "string",
        "object"
      ]
    },
    "cap_binding_preflight_ref": {
      "type": [
        "string",
        "object",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
