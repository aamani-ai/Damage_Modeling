      "adjustment_id": "HAIL_STOW_HORIZONTAL_SHIFT_V1",
      "field": "stow_state",
      "adjustment_type": "probability_blend_of_unstowed_and_stowed_curves",
      "form": "DR = P_stowed * [0.90 * logistic(D; D50+8mm, k)] + (1-P_stowed) * logistic(D; D50, k)",
      "source_ids": [
        "E_VDE_HAIL_STOW",
        "DOE_FEMP_HAIL_GUIDANCE"
      ],
      "tier": "T4_placeholder_or_expert_judgment",
      "reasoning": "Public sources support high-tilt/stow reducing normal impact severity, but do not provide a universal numeric shift. Horizontal shift preserves hail-size threshold semantics better than multiplying annual frequency.",
      "open_seam": "replace with tracker/BOM-specific hail-stow test data"
    }
  ],
  "exposure_logic": [
