    }
  ],
  "evaluation_contract": {
    "curve_form": "logistic",
    "equation": "DR(D) = max_DR / (1 + exp(-k_per_mm * (D - D50_mm)))",
    "input_field": "mesh_diameter_mm",
    "parameter_fields": [
      "D50_mm",
      "k_per_mm",
      "max_DR"
    ],
    "selector_field": "module_archetype",
    "selector_source": "curve_records[].selector_match.module_archetype",
    "missing_selector_policy": "use default_3_2mm_glass_backsheet and emit DEFAULT_SELECTOR_USED",
    "record_match_cardinality": "exactly_one",
    "asset_loss_equations": {
      "physical_base_loss_fraction": "failure_unit_DR * array_exposure_fraction * selected_value_profile.failure_unit_share_physical_base",
      "installed_capex_loss_fraction": "failure_unit_DR * array_exposure_fraction * selected_value_profile.failure_unit_share_installed_capex"
    }
  },
