  "derivation_rationale": {
    "source_spine": "Wind-pressure physics and public PV wind-load/storm-hardening sources support the axis, mechanisms, and thresholded logistic form.",
    "form_reasoning": "Structural wind damage is threshold-like but heterogeneous; thresholded logistic avoids false low-wind damage and caps failure-unit loss.",
    "demoted_sources": "Public sources do not provide a generic claims-calibrated wind-speed-to-DR table, so numeric parameters remain engineering-fit.",
    "tier_mix": "Axis bridge is T2; all v1.0 numeric structural parameters and stow multipliers are T4 engineering fits. Curve-intrinsic spread is not carried; downstream frequency-driven tail metrics remain conditional on the consumer-built annual loss distribution."
  },
  "emit_contract": {
    "schema_version": "damage_emit.v1",
