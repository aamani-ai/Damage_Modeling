    {
      "pathway_id": "straight_line_convective",
      "hazard_scope": {
        "included": [
          "downburst",
          "microburst",
          "macroburst",
          "non-tornadic thunderstorm outflow",
          "gust front",
          "local derecho outflow when local array demand is supplied"
