        "event_partition_rule": "one local convective outflow realization per array zone; nested gusts retain the parent convective event ID and are not independent occurrences"
      },
      "hazard_axis": {
        "id": "architecture_specific_convective_demand_index",
        "preferred_input_field": "architecture_input_contracts[selected_by_array_architecture].preferred_input_field",
        "permitted_proxy_fields": [
          "array_height_3s_gust_mps"
        ],
        "unit": "dimensionless",
        "valid_range": [
          0.0,
          2.0
        ],
        "extrapolation_policy": "fixed tilt: flag above 1.60 and withhold above 2.00; tracker: flag above 1.70 and withhold above 2.00; both flag below 0.20",
        "routing_field": "array_architecture",
        "architecture_input_contracts": {
          "fixed_tilt_ground_mount_screening_v1": {
            "axis_field": "fixed_tilt_event_to_design_net_pressure_ratio",
            "preferred_input_field": "fixed_tilt_event_to_design_net_pressure_ratio",
            "accepted_payloads": [
              {
                "mode": "preferred",
                "required_fields": [
                  "fixed_tilt_event_to_design_net_pressure_ratio",
                  "aerodynamic_demand_bridge_id"
                ]
              },
              {
                "mode": "screening_proxy",
                "required_fields": [
                  "array_height_3s_gust_mps",
                  "qualified_design_array_height_3s_gust_mps",
                  "convective_profile_bridge_id",
                  "aerodynamic_demand_bridge_id"
                ]
              }
            ],
            "definition": "peak transient event net-pressure demand divided by the comparable same-zone design net-pressure demand after geometry, zone, direction, and non-synoptic treatment; T4 curve medians represent the unresolved resistance transition",
            "permitted_screening_proxy": "(array_height_3s_gust_mps / qualified_design_array_height_3s_gust_mps)^2 only with named convective-profile and aerodynamic-demand bridge IDs",
            "valid_range": [0.0, 2.0]
          },
          "single_axis_tracker_qualified_screening_v1": {
            "axis_field": "tracker_instability_speed_ratio",
            "preferred_input_field": "tracker_normal_3s_gust_mps",
            "accepted_payloads": [
              {
                "mode": "preferred_qualified",
                "required_fields": [
                  "tracker_normal_3s_gust_mps",
                  "critical_instability_3s_gust_mps",
                  "aeroelastic_qualification_id",
                  "convective_profile_bridge_id",
                  "tracker_module_configuration",
                  "tracker_layout_id",
                  "tracker_position_state",
                  "tracker_angle_deg",
                  "tracker_drive_lock_state",
                  "array_zone",
                  "qualification_tracker_module_configuration",
                  "qualification_tracker_layout_id",
                  "qualification_tracker_position_state",
                  "qualification_tracker_angle_deg",
                  "qualification_array_zone",
                  "qualification_drive_lock_state",
                  "qualification_speed_averaging_s",
                  "qualification_speed_reference",
                  "qualification_convective_profile_bridge_id"
                ]
              }
            ],
            "definition": "tracker-normal local 3-second gust divided by exact-system critical-instability 3-second gust from named third-party aeroelastic test or qualified model at the attained angle/configuration",
            "equation": "tracker_normal_3s_gust_mps / critical_instability_3s_gust_mps",
            "valid_range": [0.0, 2.0],
            "stow_action_flag": "emit STOW_ACTION_THRESHOLD_EXCEEDED at ratio >= 0.75 only after event/test speed-basis and attained-state matching; this is an operational flag, not a damage threshold",
            "qualification_basis_required_match": [
              "3-second averaging period",
              "array-height tracker-normal speed reference",
              "convective-profile bridge",
              "1P/2P module configuration",
              "tracker layout",
              "attained angle and position state",
              "array zone",
              "drive/lock state"
            ]
          }
        },
        "prohibited_input": "unbridged 10 m gust, raw regional design wind speed, tracker speed without exact-system Ucrit, EF class, hurricane category, or derecho footprint-average speed"
