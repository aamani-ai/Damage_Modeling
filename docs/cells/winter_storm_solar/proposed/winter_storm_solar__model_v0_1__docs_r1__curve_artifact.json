  "pathways": [
    {
      "pathway_id": "snow_gravity_load",
      "hazard_scope": {
        "included": [
          "accumulated snowpack weight on the array, including snow already on the ground",
          "rain-on-snow water retained in the pack (carried by SWE)",
          "glaze ice weight on module surfaces, as water-equivalent load"
        ],
        "excluded": [
          "snowmelt or rain-on-snow flooding",
          "blizzard or synoptic wind loading",
          "ice plus concurrent wind",
          "ice or snow shedding impact",
          "snow drift and sliding impact on neighbouring equipment",
          "frost heave and chronic foundation movement",
          "extreme cold, freeze-off, derating",
          "hail",
          "business interruption or downtime"
        ],
        "event_partition_rule": "one parent winter event_family_id; evaluate the peak snowpack reached during the event once; do not add consecutive storms' new snow separately"
      },
      "hazard_axis": {
        "id": "winter_snow_gravity_demand",
        "preferred_input_field": "event_to_design_snow_demand_ratio",
        "permitted_proxy_fields": [
          "snow_water_equivalent_peak_mm",
          "ice_radial_thickness_mm",
          "design_ground_snow_load_kpa",
          "racking_rated_array_snow_load_kpa"
        ],
        "unit": "dimensionless",
        "valid_range": [
          0.0,
          4.0
        ],
        "extrapolation_policy": "structure ratio: flag above 3.3, withhold above 4.0; module array load: flag above 4.5 kPa, withhold above 6.0 kPa",
        "axis_contracts": {
          "structure": {
            "axis_field": "event_to_design_snow_demand_ratio",
            "unit": "dimensionless",
            "valid_range": [
              0.0,
              4.0
            ],
            "flag_above": 3.3,
            "definition": "event ground frozen load / design ground snow load (site_code_assumed) or event array load / rated array snow load (project_rated)"
          },
          "module": {
            "axis_field": "array_snow_load_kpa",
            "unit": "kPa",
            "valid_range": [
              0.0,
              6.0
            ],
            "flag_above": 4.5,
            "definition": "Cs x 0.7 x Ce x Ct x event ground frozen load"
          }
        },
        "load_bridge": {
          "swe_to_kpa_per_mm": 0.00980665,
          "glaze_kpa_per_mm_radial": 0.02772764963669371,
          "flat_roof_factor": 0.7,
          "exposure_factor_ce": 0.9,
          "thermal_factor_ct": 1.2,
          "default_slope_factor_cs": 1.0,
          "source_ids": [
            "WSS-S031",
            "WSS-S002",
            "WSS-S025"
          ],
          "snow_depth_policy": "reject snow depth without SWE (SNOW_DEPTH_WITHOUT_SWE_UNSUPPORTED)"
        }
      },
      "selector_logic": [
