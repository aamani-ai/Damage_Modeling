  "equations": {
    "event_class": "DR_u = exact_lookup(state_index, curve_u.points)",
    "conditional_distribution": "E[DR_u|burn] = sum_s(FLP_s * DR_u(s))",
    "reference_physical_loss": "sum_u(DR_u*value_u)/sum_u(value_u); support is allocated once at the same aggregate DR",
    "reference_installed_loss": "physical_loss * 877.7957023626668 / 1120"
  },
  "absolute_tolerance": 1e-12,
  "class_map": {
    "lt_2_ft": 1,
    "gte_2_lt_4_ft": 2,
    "gte_4_lt_6_ft": 3,
    "gte_6_lt_8_ft": 4,
    "gte_8_lt_12_ft": 5,
    "gte_12_ft": 6
  },
